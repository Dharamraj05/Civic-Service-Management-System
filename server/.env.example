# Copy this file to server/.env and fill in your local MySQL password.
# Never commit server/.env.

PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=csms_db

# Use a long random string in any shared environment.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

CLIENT_ORIGIN=http://localhost:5173

# Optional. If these are empty, warning notices are written to server/logs/email-warnings.log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=csms@localhost
